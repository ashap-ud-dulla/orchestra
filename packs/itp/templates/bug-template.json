{
  "id": "bug-template",
  "name": "Bug",
  "tracking": true,
  "repos": [
    "api",
    "webclient"
  ],
  "steps": [
    {
      "id": "find-it-in-the-logs",
      "skill": "bug-logs",
      "label": "Find it in the logs",
      "args": "",
      "wait": true,
      "model": "opus",
      "effort": "high"
    },
    {
      "id": "plan",
      "skill": "plan-itp",
      "label": "Plan the fix",
      "args": "This is a bug. Use the log trace in .orchestra-bug/trace.md. Reproduce and find the root cause first. Show the full plan in the chat.",
      "wait": true,
      "app": false,
      "explain": false,
      "model": "opus",
      "effort": "high"
    },
    {
      "id": "epic",
      "skill": "plan-to-epic",
      "label": "Make the epic",
      "args": "--fresh for the Plan you just wrote",
      "wait": false,
      "app": false,
      "explain": false,
      "model": "opus",
      "effort": "high"
    },
    {
      "id": "preflight",
      "skill": "epic-preflight",
      "label": "Preflight",
      "args": "the epic you just made",
      "wait": false,
      "app": false,
      "explain": false,
      "model": "opus",
      "effort": "high"
    },
    {
      "id": "build",
      "skill": "execute-epics",
      "label": "Build",
      "args": "the epic you just made and preflighted. The fix comes with a test that fails before the fix and passes after.",
      "wait": false,
      "app": false,
      "explain": false,
      "model": "sonnet",
      "effort": "high",
      "fresh": true,
      "heavy": true
    },
    {
      "id": "test-in-the-app",
      "skill": "app-test",
      "label": "Test in the app",
      "args": "",
      "wait": true,
      "model": "sonnet",
      "effort": "high",
      "heavy": true
    },
    {
      "id": "ai-itp-code-reviewer",
      "skill": "ai-itp-code-reviewer",
      "label": "ai-itp-code-reviewer",
      "args": "",
      "wait": true,
      "app": false,
      "explain": false,
      "model": "opus",
      "effort": "high",
      "fresh": true
    },
    {
      "id": "review",
      "skill": "review-changes",
      "label": "Review Changes",
      "args": "the epic you just built",
      "wait": true,
      "app": false,
      "explain": true,
      "model": "opus",
      "effort": "high"
    },
    {
      "id": "ship",
      "skill": "finalize-epic",
      "label": "Push + PR link",
      "args": "the epic you just built and reviewed",
      "wait": true,
      "app": false,
      "explain": false,
      "model": "sonnet",
      "effort": "medium"
    },
    {
      "id": "wrap-up",
      "skill": "wrap-up",
      "label": "Wrap up",
      "args": "",
      "model": "sonnet",
      "effort": "medium",
      "fresh": true
    }
  ]
}
