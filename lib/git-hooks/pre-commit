#!/bin/sh
# Orchestra: the Wrap up folders (the pack's own folder) take commits, merges and rebases on main only in Wrap up.
# In a Wrap up folder (the pack's), only the files ORCHESTRA_WRAPUP_ONLY names may be committed.
. "$(dirname "$0")/_orchestra.sh"
orchestra_no_main
if [ -n "$ORCHESTRA_WRAPUP_ONLY" ] && orchestra_is_wrapup_dir; then
  other=$(git diff --cached --name-only | grep -Ev "$ORCHESTRA_WRAPUP_ONLY" | head -5)
  [ -z "$other" ] || orchestra_refuse "in this folder only files matching $ORCHESTRA_WRAPUP_ONLY may be committed, not: $(echo $other)"
fi
orchestra_chain pre-commit "$@"
