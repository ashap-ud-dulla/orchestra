#!/bin/sh
# Orchestra: every push needs ORCHESTRA_ALLOW_PUSH=1; a run's terminal session sets it, because there Claude asks
# you before every push, a push to main too (the PreToolUse guard). The folders the pack keeps on main (its notes,
# its own folder) push to main only while the Wrap up step works.
. "$(dirname "$0")/_orchestra.sh"
input=$(cat)
to_main=
for ref in $(printf '%s\n' "$input" | awk '{ print $3 }'); do
  orchestra_is_main "${ref#refs/heads/}" && to_main=1
done
if [ -n "$to_main" ]; then
  if { orchestra_main_ok || orchestra_is_wrapup_dir; } && ! orchestra_wrap_up; then
    orchestra_refuse "this folder is pushed to main only in the Wrap up step."
  fi
fi
if [ "$ORCHESTRA_ALLOW_PUSH" != "1" ]; then
  orchestra_refuse "this push needs the user's Approve."
fi
printf '%s\n' "$input" | orchestra_chain pre-push "$@"
