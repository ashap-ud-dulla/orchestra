#!/bin/sh
# Orchestra: a push to main (or master, or with no pack the remote's default branch) is always refused. Other pushes
# need ORCHESTRA_ALLOW_PUSH=1; a run's terminal session sets it, because there Claude asks you before every push
# (the PreToolUse guard).
. "$(dirname "$0")/_orchestra.sh"
input=$(cat)
to_main=
for ref in $(printf '%s\n' "$input" | awk '{ print $3 }'); do
  orchestra_is_main "${ref#refs/heads/}" && to_main=1
done
if [ -n "$to_main" ]; then
  # One exception: the Wrap up step pushes the vault and the ITP folder, which live on main.
  if orchestra_wrap_up && { orchestra_main_ok || orchestra_is_itp; }; then
    :
  else
    orchestra_refuse "a push to the main branch is refused, even with Approve."
  fi
fi
if [ "$ORCHESTRA_ALLOW_PUSH" != "1" ]; then
  orchestra_refuse "this push needs the user's Approve."
fi
printf '%s\n' "$input" | orchestra_chain pre-push "$@"
